{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "{{CLI}} agent context --hook", "timeout": 20 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Monitor|Agent|Task|Workflow|Edit|Write|NotebookEdit|AskUserQuestion", "hooks": [{ "type": "command", "command": "{{CLI}} agent guard", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "{{CLI}} agent context --hook", "timeout": 20 }] }
    ]
  }
}
