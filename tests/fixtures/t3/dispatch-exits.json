{
  "t3_version": "0.0.45",
  "about": "The `exit` of T3's answer to orchestration.dispatchCommand, and what it means for the command: accepted (it ran), refused (it provably did nothing, so it may be changed or dropped) or unknown (it may have run, so only the same command may be sent again). Read by src/t3.rs and app/Squircle/Tests/T3Tests.swift; add a case here when T3 answers in a new shape.",
  "cases": [
    { "name": "receipt", "outcome": "accepted",
      "exit": { "_tag": "Success", "value": { "sequence": 4 } } },
    { "name": "rejected receipt", "outcome": "refused",
      "exit": { "_tag": "Success", "value": { "status": "rejected", "reason": "Thread is archived" } } },
    { "name": "typed failure", "outcome": "refused",
      "exit": { "_tag": "Failure", "cause": [ { "_tag": "Fail", "error": { "_tag": "OrchestrationDispatchCommandError", "message": "no" } } ] } },
    { "name": "previously rejected", "outcome": "refused",
      "exit": { "_tag": "Failure", "cause": [ { "_tag": "Fail", "error": { "_tag": "OrchestrationCommandPreviouslyRejectedError" } } ] } },
    { "name": "single typed failure, not in a list", "outcome": "refused",
      "exit": { "_tag": "Failure", "cause": { "_tag": "Fail", "error": { "_tag": "OrchestrationDispatchCommandError" } } } },
    { "name": "internal error", "outcome": "unknown",
      "exit": { "_tag": "Failure", "cause": [ { "_tag": "Fail", "error": { "_tag": "InternalError" } } ] } },
    { "name": "defect", "outcome": "unknown",
      "exit": { "_tag": "Failure", "cause": { "_tag": "Die", "defect": "boom" } } },
    { "name": "interrupted", "outcome": "unknown",
      "exit": { "_tag": "Failure", "cause": [ { "_tag": "Interrupt", "fiberId": 7 } ] } },
    { "name": "untagged error", "outcome": "unknown",
      "exit": { "_tag": "Failure", "cause": [ { "_tag": "Fail", "error": { "message": "?" } } ] } }
  ]
}
